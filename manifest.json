{
  "manifest_version": 3,
  "name": "Compliance Central - Michigan Dealer Compliance Hub",
  "short_name": "Compliance",
  "version": "1.5.1",
  "minimum_chrome_version": "114",
  "description": "Unified compliance screening for Michigan auto dealers. OFAC sanctions, Repeat Offender, and Title/Lien checks in one sidebar tool.",
  "homepage_url": "https://techsavvyjoe.github.io/compliance-central/",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://sanctionslistservice.ofac.treas.gov/*",
    "https://wc2h-sls-prod-public-published.s3.us-gov-west-1.amazonaws.com/*",
    "https://compliance-central-api.fly.dev/*",
    "https://dsvsesvc.sos.state.mi.us/*",
    "https://vpic.nhtsa.dot.gov/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://dsvsesvc.sos.state.mi.us/TAP/_/*"],
      "js": [
        "lib/html2canvas.min.js",
        "sos-fee-quote-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: blob: https://dsvsesvc.sos.state.mi.us https://www.michigan.gov"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Compliance Central"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
